# ---- required ----
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=
LOGGER_ID=            # a group/channel id where the bot and assistant can post (e.g. -100123...)
SESSION=              # Pyrogram/Kurigram session string of the assistant account
# SESSION2= ... SESSION5=   more assistants share the load

# ---- storage (leave MONGO_URL empty to use data/state.json) ----
MONGO_URL=

# ---- limits ----
DURATION_LIMIT=180    # minutes
QUEUE_LIMIT=50
PLAYLIST_LIMIT=25

# ---- speed knobs ----
PREFETCH=true             # resolve the next song while the current one plays
CACHE_DOWNLOADS=true      # background file copy of the playing song (replays/loops/seeks)
CACHE_MAX_MB=1500
YTDLP_WORKERS=4
RESOLVE_TIMEOUT=30
FFMPEG_FAST_PROBE=false   # try true for slightly quicker starts
YT_PLAYER_CLIENTS=        # e.g. "tv,web_safari" - blank = yt-dlp default
COOKIES_URL=              # optional https links to cookies.txt files (space separated)

# ---- behaviour ----
IDLE_LEAVE_SECONDS=300
THUMB_GEN=true
VIDEO_PLAY=true

# ---- links ----
SUPPORT_CHAT=
SUPPORT_CHANNEL=
START_IMG=
